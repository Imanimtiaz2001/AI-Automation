# Used ONCE by scripts/bootstrap.sh to create the n8n credentials (stored encrypted with N8N_ENCRYPTION_KEY).
# These values are never passed to the running n8n container's environment and never appear in workflow JSON.
# You can also skip this file and enter the four credentials in the n8n UI (Credentials page).
LLM_API_KEY=sk-...
FB_PAGE_ACCESS_TOKEN=EAAG...            # long-lived Page access token (see docs/facebook-setup.md)
TELEGRAM_BOT_TOKEN=123456789:AA...      # from @BotFather
