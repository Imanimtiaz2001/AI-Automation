# ---------------------------------------------------------------------------------------------
# Infrastructure (docker-compose). Generate random values, e.g.  openssl rand -hex 24
# ---------------------------------------------------------------------------------------------
N8N_VERSION=2.45.5
POSTGRES_USER=placidway
POSTGRES_PASSWORD=change-me-postgres-password
N8N_ENCRYPTION_KEY=change-me-32-random-characters-please
N8N_RUNNERS_AUTH_TOKEN=change-me-runner-token
# Public base URL of n8n. Approval links point here, so in approval mode it must be reachable from the
# reviewer's phone (e.g. a Cloudflare Tunnel / ngrok URL). http://localhost:5678/ is fine for auto mode.
WEBHOOK_URL=http://localhost:5678/

# ---------------------------------------------------------------------------------------------
# Run configuration (read by the Config node). Secrets do NOT go here: see .env.secrets.example.
# ---------------------------------------------------------------------------------------------
# true = simulation: everything runs, the exact Graph API request is logged, nothing is posted.
PW_DRY_RUN=true
# auto = publish without a human; approval = draft goes to Telegram with Approve / Reject links.
PW_REVIEW_MODE=approval
# now = publish when the run (or the approval) completes; schedule = Facebook scheduled post at PW_SCHEDULE_TIME.
PW_PUBLISH_STRATEGY=now
PW_SCHEDULE_TIME=18:00
# Timezone for "one post per day", the 09:00/11:00/14:00 slots (see README) and scheduling.
PW_TIMEZONE=America/Denver
# photo = image + caption (falls back to a link post); link = link-preview post.
PW_POST_FORMAT=photo

# Facebook test Page you own (never a PlacidWay page). Required when PW_DRY_RUN=false.
PW_FB_PAGE_ID=
PW_FB_GRAPH_VERSION=v23.0
# Optional cross-post: Instagram professional account id linked to that Page (leave empty to disable).
PW_IG_USER_ID=

# Any OpenAI-compatible endpoint works (OpenAI, Azure OpenAI, OpenRouter, Groq, local vLLM...).
PW_LLM_BASE_URL=https://api.openai.com/v1
PW_LLM_MODEL=gpt-4.1-mini
# Optional: a different (ideally stronger or different-vendor) model for the compliance judge.
PW_LLM_JUDGE_MODEL=
PW_VARIANTS=3

# Telegram chat that receives drafts (approval mode), alerts and success notifications.
PW_TELEGRAM_CHAT_ID=
PW_NOTIFY_ON_SUCCESS=true
PW_REVIEW_TIMEOUT_HOURS=20

# Crawling etiquette: identify yourself and keep >= 1000 ms between requests.
PW_USER_AGENT=PlacidWayContentDemoBot/1.0 (+contact: you@example.com)
PW_REQUEST_INTERVAL_MS=1500
# Variety rule: preferred content type for Mon..Sun (article|package|answer|any).
PW_ROTATION=article,package,answer,article,package,answer,article
PW_MAX_ATTEMPTS=3
PW_DISCLAIMER=General information only, not medical advice.
